#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        d {
            bindings = <&kp D>;
            key-positions = <3 1>;
            layers = <0>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <4 7>;
            layers = <0>;
        };

        c {
            bindings = <&kp C>;
            key-positions = <7 6>;
            layers = <0>;
        };

        f {
            bindings = <&kp F>;
            key-positions = <3 2>;
            layers = <0>;
        };

        g {
            bindings = <&kp G>;
            key-positions = <2 1>;
            layers = <0>;
        };

        h {
            bindings = <&kp H>;
            key-positions = <5 7>;
            layers = <0>;
        };

        j {
            bindings = <&kp J>;
            key-positions = <1 0>;
            layers = <0>;
        };

        k {
            bindings = <&kp K>;
            key-positions = <4 6>;
            layers = <0>;
        };

        l {
            bindings = <&kp L>;
            key-positions = <4 0>;
            layers = <0>;
        };

        m {
            bindings = <&kp M>;
            key-positions = <4 5>;
            layers = <0>;
        };

        n {
            bindings = <&kp P>;
            key-positions = <0 6>;
            layers = <0>;
        };

        q_old {
            bindings = <&kp Q>;
            key-positions = <0 1 3>;
            layers = <0>;
        };

        qu {
            bindings = <&qu>;
            key-positions = <1 7>;
        };

        s {
            bindings = <&kp S>;
            key-positions = <0 5>;
            layers = <0>;
        };

        u {
            bindings = <&kp U>;
            key-positions = <5 6>;
            layers = <0>;
        };

        v {
            bindings = <&kp V>;
            key-positions = <2 0>;
            layers = <0>;
        };

        w {
            bindings = <&kp W>;
            key-positions = <0 3>;
            layers = <0>;
        };

        x {
            bindings = <&kp X>;
            key-positions = <1 6>;
            layers = <0>;
        };

        y {
            bindings = <&kp Y>;
            key-positions = <6 2>;
            layers = <0>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <2 4>;
            layers = <0>;
        };

        caps_lock {
            bindings = <&kp CLCK>;
            key-positions = <4 5 6 3>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <5 6 3>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <5 3>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <5 1>;
            layers = <0>;
        };

        full_stop {
            bindings = <&kp PERIOD>;
            key-positions = <6 3>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <3 4>;
            layers = <0>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <2 7>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <2 5>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <3 7>;
        };

        bluetooth {
            bindings = <&to 8>;
            key-positions = <4 0 3 7>;
        };

        clear_bt_profile {
            bindings = <&bt BT_CLR>;
            key-positions = <5 6 2 1>;
            layers = <9>;
        };

        hyphen {
            bindings = <&kp MINUS>;
            key-positions = <4 1>;
            layers = <0>;
        };

        semi_colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 5 4>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <6 5 7>;
        };

        question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <4 1 6>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <4 5 2>;
        };

        left_bracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 2 3>;
        };

        right_bracket {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 7 6>;
        };

        at_symbol {
            bindings = <&kp AT_SIGN>;
            key-positions = <5 2 7>;
        };

        back_slash {
            bindings = <&kp NON_US_BSLH>;
            key-positions = <0 7>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 1 3>;
        };

        hash {
            bindings = <&kp NON_US_HASH>;
            key-positions = <6 3 2 7>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <0 4 5 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2 3>;
        };

        n9 {
            bindings = <&kp N9>;
            key-positions = <0 7>;
            layers = <3>;
        };

        n0 {
            bindings = <&kp N0>;
            key-positions = <0 6>;
            layers = <3>;
        };

        bluetooth_off {
            bindings = <&to 0>;
            key-positions = <4 0 3 7>;
            layers = <8>;
        };

        ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <2 0 4>;
        };

        ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <0 4 3>;
        };

        ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <0 4 1>;
        };

        ctrl_y {
            bindings = <&kp LC(Y)>;
            key-positions = <0 4 5>;
        };

        ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <0 4 6>;
        };

        ctrl_w {
            bindings = <&kp LC(W)>;
            key-positions = <0 4 7>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1 2>;
        };

        print_screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <1 4 7>;
        };
    };

    macros {
        qu: qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "QU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 4 R      &kp A  &kp I  &lt 9 N
&lt 2 SPACE  &kp T  &kp O  &lt 1 E
            >;

            label = "rain toe";
        };

        mouse {
            bindings = <
&mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans
&mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
            >;

            label = "mouse";
        };

        arrows {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &lt 10 END
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT
            >;

            label = "arrows";
        };

        numbers {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &lt 9 NUMBER_4
&kp N5        &kp NUMBER_6  &kp N7        &kp N8
            >;

            label = "numbers";
        };

        modifiers {
            bindings = <
&trans          &trans            &trans        &trans
&kt LEFT_SHIFT  &kt LEFT_CONTROL  &kt LEFT_ALT  &kt LEFT_GUI
            >;

            label = "mods";
        };

        functions {
            bindings = <
&kp F1  &kp F2  &kp F3  &lt 9 F4
&kp F5  &kp F6  &kp F7  &kp F8
            >;

            label = "functions";
        };

        media {
            bindings = <
&trans        &kp C_PAUSE       &trans              &lt 9 C_VOL_UP
&kp C_REWIND  &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp C_VOLUME_DOWN
            >;

            label = "media";
        };

        custom {
            bindings = <
&trans  &trans       &trans  &lt 9 SPACE
&trans  &bootloader  &trans  &trans
            >;

            label = "custom";
        };

        bluetooth {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &out OUT_BLE
&bt BT_SEL 3  &bt BT_SEL 4  &to 0         &out OUT_USB
            >;

            label = "bluetooth";
        };

        layer_select {
            bindings = <
&to 0  &to 3  &to 6  &trans
&to 2  &to 5  &to 7  &to 1
            >;

            label = "layers";
        };
    };
};
