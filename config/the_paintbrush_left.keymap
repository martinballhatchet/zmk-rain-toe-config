#include <dt-bindings/zmk/hid_usage_pages.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define NATIVE_FULLSCREEN (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x0232))

/ {
    combos {
        compatible = "zmk,combos";

        d {
            bindings = <&kp D>;
            key-positions = <3 1>;
            layers = <0>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <4 7>;
            layers = <0>;
        };

        c {
            bindings = <&kp C>;
            key-positions = <7 6>;
            layers = <0>;
        };

        f {
            bindings = <&kp F>;
            key-positions = <3 2>;
            layers = <0>;
        };

        g {
            bindings = <&kp G>;
            key-positions = <2 1>;
            layers = <0>;
        };

        h {
            bindings = <&kp H>;
            key-positions = <5 7>;
            layers = <0>;
        };

        j {
            bindings = <&kp J>;
            key-positions = <1 0>;
            layers = <0>;
        };

        k {
            bindings = <&kp K>;
            key-positions = <4 6>;
            layers = <0>;
        };

        l {
            bindings = <&kp L>;
            key-positions = <4 0>;
            layers = <0>;
        };

        m {
            bindings = <&kp M>;
            key-positions = <4 5>;
            layers = <0>;
        };

        n {
            bindings = <&kp P>;
            key-positions = <0 6>;
            layers = <0>;
        };

        q_old {
            bindings = <&kp Q>;
            key-positions = <0 1 3>;
            layers = <0>;
        };

        qu {
            bindings = <&qu>;
            key-positions = <1 7>;
        };

        s {
            bindings = <&kp S>;
            key-positions = <0 5>;
            layers = <0>;
        };

        u {
            bindings = <&kp U>;
            key-positions = <5 6>;
            layers = <0>;
        };

        v {
            bindings = <&kp V>;
            key-positions = <2 0>;
            layers = <0>;
        };

        w {
            bindings = <&kp W>;
            key-positions = <0 3>;
            layers = <0>;
        };

        x {
            bindings = <&kp X>;
            key-positions = <1 6>;
            layers = <0>;
        };

        y {
            bindings = <&kp Y>;
            key-positions = <6 2>;
            layers = <0>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <2 4>;
            layers = <0>;
        };

        caps_lock {
            bindings = <&kp CLCK>;
            key-positions = <4 5 6 3>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <5 6 3>;
            layers = <0 1>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <5 3>;
            layers = <0 1>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <5 1>;
            layers = <0>;
        };

        full_stop {
            bindings = <&kp PERIOD>;
            key-positions = <6 3>;
            layers = <0 1>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <3 4>;
            layers = <0 1>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <2 7>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <2 5>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <3 7>;
        };

        bluetooth {
            bindings = <&tog 8>;
            key-positions = <4 0 3 7>;
        };

        clear_bt_profile {
            bindings = <&bt BT_CLR>;
            key-positions = <5 6 2 1>;
            layers = <8>;
        };

        hyphen {
            bindings = <&kp MINUS>;
            key-positions = <4 1>;
            layers = <0>;
            layers = <0 1>;
        };

        semi_colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 5 4>;
            layers = <0 1>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <6 5 7>;
            layers = <0 1>;
        };

        question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <1 2 7>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <4 5 2>;
            layers = <0 1>;
        };

        left_bracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 2 3>;
            layers = <0 1>;
        };

        right_bracket {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 7 6>;
            layers = <0 1>;
        };

        at_symbol {
            bindings = <&kp AT_SIGN>;
            key-positions = <5 2 7>;
        };

        back_slash {
            bindings = <&kp NON_US_BSLH>;
            key-positions = <0 7>;
            layers = <0 1>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 1 3>;
            layers = <0 1>;
        };

        hash {
            bindings = <&kp NON_US_HASH>;
            key-positions = <6 3 2 7>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <0 4 5 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2 3>;
        };

        n9 {
            bindings = <&kp N9>;
            key-positions = <0 7>;
            layers = <1>;
        };

        n0 {
            bindings = <&kp N0>;
            key-positions = <0 6>;
            layers = <1>;
        };

        bluetooth_off {
            bindings = <&to 0>;
            key-positions = <4 0 3 7>;
            layers = <8>;
        };

        ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <2 0 4>;
        };

        ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <0 4 3>;
        };

        ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <0 4 1>;
        };

        ctrl_y {
            bindings = <&kp LC(Y)>;
            key-positions = <0 4 5>;
        };

        ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <0 4 6>;
        };

        ctrl_w {
            bindings = <&kp LC(W)>;
            key-positions = <0 4 7>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1 2>;
        };

        print_screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <1 4 7>;
        };

        f9 {
            bindings = <&kp F9>;
            key-positions = <0 7>;
            layers = <2>;
        };

        f10 {
            bindings = <&kp F10>;
            key-positions = <0 6>;
            layers = <2>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <0 5>;
            layers = <2>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <0 4>;
            layers = <2>;
        };

        left_square_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <0 2 3>;
            layers = <0 1>;
        };

        right_square_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <0 6 7>;
            layers = <0 1>;
        };

        left_curly_bracket {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <0 7 1>;
            layers = <0 1>;
        };

        right_curly_breacket {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 4 5>;
            layers = <0 1>;
        };

        pound {
            bindings = <&kp HASH>;
            key-positions = <5 2 3>;
            layers = <0 1>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <1 6 7>;
            layers = <0 1>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <6 4 3>;
            layers = <0 1>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <4 3 1>;
            layers = <0 1>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <0 5 6>;
            layers = <0 1>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <4 1 2>;
            layers = <0 1>;
        };

        negation {
            bindings = <&kp LS(GRAVE)>;
            key-positions = <1 0 6>;
            layers = <0 1>;
        };

        double_pipe {
            bindings = <&kp RA(GRAVE)>;
            key-positions = <1 4 5>;
            layers = <0 1>;
        };

        back_tick {
            bindings = <&kp GRAVE>;
            key-positions = <4 5 3>;
            layers = <0 1>;
        };

        page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <4 2 7>;
        };

        page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <6 3 0>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <0 7 2>;
            layers = <0 1>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <0 2 5>;
            layers = <0 1>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <4 1 6>;
            layers = <0 1>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 5 3>;
            layers = <0 1>;
        };

        media_mouse_scroll_up {
            bindings = <&msc SCRL_UP>;
            key-positions = <0 2>;
            layers = <3>;
        };

        media_mouse_scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <0 6>;
            layers = <3>;
        };

        media_back {
            bindings = <&kp K_BACK>;
            key-positions = <0 1>;
            layers = <3>;
        };

        media_forwards {
            bindings = <&kp K_FORWARD>;
            key-positions = <0 3>;
            layers = <3>;
        };

        arrows_page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <2 6>;
            layers = <5>;
        };

        arrows_page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <5 7>;
            layers = <5>;
        };

        mouse_layer_scroll_up {
            bindings = <&msc SCRL_UP>;
            key-positions = <1 4 6>;
            layers = <6>;
        };

        mouse_layer_scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <5 6 4>;
            layers = <6>;
        };

        mouse_layer_scroll_left {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <5 4 1>;
            layers = <6>;
        };

        mouse_layer_scroll_right {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <6 1 5>;
            layers = <6>;
        };

        media_search {
            bindings = <&kp C_AC_SEARCH>;
            key-positions = <1 6>;
            layers = <3>;
        };
    };

    macros {
        qu: qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "QU";
        };

        android_fullscreen: android_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x0232)>,
                <&macro_release>,
                <&kp ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x0232)>;
        };
    };

    behaviors {
        toggle_stick: toggle_stick {
            compatible = "zmk,behavior-hold-tap";
            label = "TOGGLE_STICK";
            bindings = <&kt>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
        };

        out_or_layer: out_or_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "OUT_OR_LAYER";
            bindings = <&mo>, <&out>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 7 R      &kp A  &kp I  &lt 9 N
&lt 5 SPACE  &kp T  &kp O  &lt 6 E
            >;

            label = "rain toe";
        };

        numbers {
            bindings = <
&lt 7 NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &lt 9 NUMBER_4
&lt 5 N5        &kp NUMBER_6  &kp N7        &lt 6 N8
            >;

            label = "numbers";
        };

        functions {
            bindings = <
&lt 7 F1  &kp F2  &kp F3  &lt 9 F4
&lt 5 F5  &kp F6  &kp F7  &lt 6 F8
            >;

            label = "functions";
        };

        media {
            bindings = <
&trans          &android_fullscreen  &kp C_AC_HOME       &lt 9 C_VOL_UP
&lt 5 C_REWIND  &kp C_PLAY_PAUSE     &kp C_FAST_FORWARD  &lt 6 C_VOLUME_DOWN
            >;

            label = "media&mob";
        };

        custom {
            bindings = <
&kp LG(TAB)       &ext_power EP_TOG  &soft_off            &lt 9 SPACE
&ext_power EP_ON  &bootloader        &android_fullscreen  &sys_reset
            >;

            label = "custom";
        };

        arrows {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &lt 9 END
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT
            >;

            label = "arrows";
        };

        mouse {
            bindings = <
&mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans
&mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
            >;

            label = "mouse";
        };

        modifiers {
            bindings = <
&trans                               &kp LC(X)                                &kp LC(C)                        &kp LC(V)
&toggle_stick LEFT_SHIFT LEFT_SHIFT  &toggle_stick LEFT_CONTROL LEFT_CONTROL  &toggle_stick LEFT_ALT LEFT_ALT  &toggle_stick LEFT_GUI LEFT_GUI
            >;

            label = "mods";
        };

        bluetooth {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &out_or_layer 9 OUT_BLE
&bt BT_SEL 3  &bt BT_SEL 4  &to 0         &out OUT_USB
            >;

            label = "bluetooth";
        };

        layer_select {
            bindings = <
&to 0  &to 1  &to 2  &trans
&to 5  &to 3  &to 4  &to 6
            >;

            label = "layers";
        };
    };
};
